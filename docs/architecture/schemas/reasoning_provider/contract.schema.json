{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://schemas.cryptotrust.local/ports/reasoning-provider/1.0.0/contract.schema.json",
  "title":"ReasoningProvider Port contract",
  "x-contract-version":"1.0.0",
  "x-port-policy":{"retry_owner":"core","hidden_adapter_retries":false,"sequence":"primary generate, at most one primary repair, fallback generate, validate","repair_timeout_ms":60000,"health_timeout_ms":3000,"context_limits":{"canonical_json_bytes":524288,"provider_tokens":64000,"evidence":120,"analysis":32,"contradictions":64,"limitations":50},"idempotency":"operation_id plus context hash, role and model version identify one invocation","concurrency":"Core controls calls; provider has no network, database, secret or tool access"},
  "x-forbidden-output-fields":["chain_of_thought","prompt","raw_prompt","hidden_reasoning"],
  "x-error-codes":["context_invalid","context_too_large","guardrail_rejected","reasoning_schema_invalid","citation_invalid","numeric_inconsistency","reasoning_timeout","reasoning_rate_limited","model_unavailable","fallback_unavailable","deadline_exceeded","unexpected_provider_error"],
  "oneOf":[{"$ref":"#/$defs/GenerateOperation"},{"$ref":"#/$defs/RepairOperation"},{"$ref":"#/$defs/HealthOperation"}],
  "$defs":{
    "Deadline":{"$ref":"https://schemas.cryptotrust.local/common/1.0.0/common.schema.json#/$defs/DeadlineDTO"},"OperationId":{"$ref":"https://schemas.cryptotrust.local/common/1.0.0/common.schema.json#/$defs/OperationId"},"TaskId":{"$ref":"https://schemas.cryptotrust.local/common/1.0.0/common.schema.json#/$defs/TaskId"},"ExecutionId":{"$ref":"https://schemas.cryptotrust.local/common/1.0.0/common.schema.json#/$defs/ExecutionId"},"Utc":{"$ref":"https://schemas.cryptotrust.local/common/1.0.0/common.schema.json#/$defs/UtcInstant"},"Hash":{"$ref":"https://schemas.cryptotrust.local/common/1.0.0/common.schema.json#/$defs/Sha256"},"Probability":{"$ref":"https://schemas.cryptotrust.local/common/1.0.0/common.schema.json#/$defs/Probability"},"Health":{"$ref":"https://schemas.cryptotrust.local/common/1.0.0/common.schema.json#/$defs/ProviderHealthDTO"},
    "GenerateErrorResult":{"allOf":[{"$ref":"https://schemas.cryptotrust.local/common/1.0.0/common.schema.json#/$defs/ErrorResult"},{"properties":{"error":{"properties":{"code":{"enum":["context_invalid","context_too_large","guardrail_rejected","reasoning_schema_invalid","citation_invalid","numeric_inconsistency","reasoning_timeout","reasoning_rate_limited","model_unavailable","fallback_unavailable","deadline_exceeded","unexpected_provider_error"]}}}}}]},
    "RepairErrorResult":{"allOf":[{"$ref":"https://schemas.cryptotrust.local/common/1.0.0/common.schema.json#/$defs/ErrorResult"},{"properties":{"error":{"properties":{"code":{"enum":["guardrail_rejected","reasoning_schema_invalid","citation_invalid","numeric_inconsistency","reasoning_timeout","reasoning_rate_limited","model_unavailable","deadline_exceeded","unexpected_provider_error"]}}}}}]},
    "HealthErrorResult":{"allOf":[{"$ref":"https://schemas.cryptotrust.local/common/1.0.0/common.schema.json#/$defs/ErrorResult"},{"properties":{"error":{"properties":{"code":{"enum":["reasoning_timeout","model_unavailable","fallback_unavailable","deadline_exceeded","unexpected_provider_error"]}}}}}]},
    "EvidenceRefDTO":{"type":"object","additionalProperties":false,"required":["evidence_id","assessment_id","excerpt","stance","confidence"],"properties":{"evidence_id":{"type":"string","pattern":"^EVID-"},"assessment_id":{"type":"string","pattern":"^ASSESS-"},"excerpt":{"type":"string","minLength":1,"maxLength":2000},"stance":{"enum":["supports","contradicts","context"]},"confidence":{"$ref":"#/$defs/Probability"}}},
    "AnalysisRefDTO":{"type":"object","additionalProperties":false,"required":["analysis_id","analysis_version","summary","source_refs"],"properties":{"analysis_id":{"type":"string","pattern":"^ANALYSIS-"},"analysis_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},"summary":{"type":"string","minLength":1,"maxLength":2000},"source_refs":{"type":"array","minItems":1,"maxItems":100,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":256}}}},
    "ContradictionDTO":{"type":"object","additionalProperties":false,"required":["contradiction_id","evidence_refs","severity","summary"],"properties":{"contradiction_id":{"type":"string","pattern":"^CONTRA-"},"evidence_refs":{"type":"array","minItems":2,"maxItems":20,"uniqueItems":true,"items":{"type":"string","pattern":"^EVID-"}},"severity":{"enum":["low","medium","high"]},"summary":{"type":"string","minLength":1,"maxLength":2000}}},
    "ReasoningContextDTO":{"type":"object","additionalProperties":false,"required":["schema_version","question","evidence_refs","analysis_refs","contradictions","limitations","omissions"],"properties":{"schema_version":{"const":"1.0.0"},"question":{"type":"string","minLength":1,"maxLength":2000},"evidence_refs":{"type":"array","maxItems":120,"uniqueItems":true,"items":{"$ref":"#/$defs/EvidenceRefDTO"}},"analysis_refs":{"type":"array","maxItems":32,"uniqueItems":true,"items":{"$ref":"#/$defs/AnalysisRefDTO"}},"contradictions":{"type":"array","maxItems":64,"uniqueItems":true,"items":{"$ref":"#/$defs/ContradictionDTO"}},"limitations":{"type":"array","maxItems":50,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":512}},"omissions":{"type":"array","maxItems":100,"uniqueItems":true,"items":{"type":"object","additionalProperties":false,"required":["kind","count","reason"],"properties":{"kind":{"enum":["evidence","analysis","contradiction","limitation"]},"count":{"type":"integer","minimum":1},"reason":{"const":"deterministic_context_limit"}}}}},"x-canonical-json-max-bytes":524288,"x-provider-token-max":64000,"x-semantic-constraints":[{"rule":"canonical_json_size_at_most_bytes","maximum":524288,"shared_semantic_assertion_required":true},{"rule":"provider_token_count_at_most","maximum":64000,"shared_semantic_assertion_required":true},{"rule":"all_references_are_task_scoped","shared_semantic_assertion_required":true},{"rule":"evidence_is_active_and_not_quarantined","shared_semantic_assertion_required":true},{"rule":"assessment_is_latest_by_max_assessment_sequence","shared_semantic_assertion_required":true},{"rule":"citation_graph_is_complete_and_resolvable","shared_semantic_assertion_required":true}]},
    "GenerateRequest":{"type":"object","additionalProperties":false,"required":["schema_version","operation_id","task_id","execution_id","model_role","context","context_hash","output_schema_version","guardrail_policy_version","deadline"],"properties":{"schema_version":{"const":"1.0.0"},"operation_id":{"$ref":"#/$defs/OperationId"},"task_id":{"$ref":"#/$defs/TaskId"},"execution_id":{"$ref":"#/$defs/ExecutionId"},"model_role":{"enum":["primary","fallback"]},"context":{"$ref":"#/$defs/ReasoningContextDTO"},"context_hash":{"$ref":"#/$defs/Hash"},"output_schema_version":{"const":"1.0.0"},"guardrail_policy_version":{"type":"string","pattern":"^[a-z0-9_-]+-[0-9]+\\.[0-9]+\\.[0-9]+$"},"deadline":{"$ref":"#/$defs/Deadline"}}},
    "ProviderDTO":{"type":"object","additionalProperties":false,"required":["name","model_version","model_role","invocation_id"],"properties":{"name":{"type":"string","minLength":1,"maxLength":128},"model_version":{"type":"string","minLength":1,"maxLength":128},"model_role":{"enum":["primary","fallback"]},"invocation_id":{"type":"string","minLength":1,"maxLength":128}}},
    "FactDTO":{"type":"object","additionalProperties":false,"required":["fact_id","statement","evidence_refs","analysis_refs"],"properties":{"fact_id":{"type":"string","pattern":"^FACT-"},"statement":{"type":"string","minLength":1,"maxLength":2000},"evidence_refs":{"type":"array","maxItems":50,"uniqueItems":true,"items":{"type":"string","pattern":"^EVID-"}},"analysis_refs":{"type":"array","maxItems":50,"uniqueItems":true,"items":{"type":"string","pattern":"^ANALYSIS-"}}},"anyOf":[{"properties":{"evidence_refs":{"minItems":1}},"required":["evidence_refs"]},{"properties":{"analysis_refs":{"minItems":1}},"required":["analysis_refs"]}]},
    "InferenceDTO":{"type":"object","additionalProperties":false,"required":["inference_id","statement","fact_refs","confidence"],"properties":{"inference_id":{"type":"string","pattern":"^INFER-"},"statement":{"type":"string","minLength":1,"maxLength":2000},"fact_refs":{"type":"array","minItems":1,"maxItems":50,"uniqueItems":true,"items":{"type":"string","pattern":"^FACT-"}},"confidence":{"$ref":"#/$defs/Probability"}}},
    "ConclusionDTO":{"type":"object","additionalProperties":false,"required":["conclusion_id","statement","fact_refs","inference_refs","confidence"],"properties":{"conclusion_id":{"type":"string","pattern":"^CONCL-"},"statement":{"type":"string","minLength":1,"maxLength":2000},"fact_refs":{"type":"array","maxItems":50,"uniqueItems":true,"items":{"type":"string","pattern":"^FACT-"}},"inference_refs":{"type":"array","maxItems":50,"uniqueItems":true,"items":{"type":"string","pattern":"^INFER-"}},"confidence":{"$ref":"#/$defs/Probability"}},"anyOf":[{"properties":{"fact_refs":{"minItems":1}},"required":["fact_refs"]},{"properties":{"inference_refs":{"minItems":1}},"required":["inference_refs"]}]},
    "ConfidenceComponentsDTO":{"type":"object","additionalProperties":false,"required":["evidence_quality","consistency","coverage","overall"],"properties":{"evidence_quality":{"$ref":"#/$defs/Probability"},"consistency":{"$ref":"#/$defs/Probability"},"coverage":{"$ref":"#/$defs/Probability"},"overall":{"$ref":"#/$defs/Probability"}}},
    "DiagnosticDTO":{"type":"object","additionalProperties":false,"required":["path","code","safe_message"],"properties":{"path":{"type":"string","minLength":1,"maxLength":256},"code":{"type":"string","pattern":"^[a-z][a-z0-9_]{0,63}$"},"safe_message":{"type":"string","minLength":1,"maxLength":512}}},
    "ReasoningResultDTO":{"type":"object","additionalProperties":false,"required":["schema_version","outcome","provider","facts","inferences","conclusions","limitations","watchpoints","confidence_components","validation_diagnostics","started_at","finished_at"],"properties":{"schema_version":{"const":"1.0.0"},"outcome":{"enum":["valid","invalid"]},"provider":{"$ref":"#/$defs/ProviderDTO"},"facts":{"type":"array","maxItems":200,"items":{"$ref":"#/$defs/FactDTO"}},"inferences":{"type":"array","maxItems":100,"items":{"$ref":"#/$defs/InferenceDTO"}},"conclusions":{"type":"array","maxItems":50,"items":{"$ref":"#/$defs/ConclusionDTO"}},"limitations":{"type":"array","maxItems":50,"items":{"type":"string","minLength":1,"maxLength":512}},"watchpoints":{"type":"array","maxItems":50,"items":{"type":"string","minLength":1,"maxLength":512}},"confidence_components":{"$ref":"#/$defs/ConfidenceComponentsDTO"},"validation_diagnostics":{"type":"array","maxItems":100,"items":{"$ref":"#/$defs/DiagnosticDTO"}},"started_at":{"$ref":"#/$defs/Utc"},"finished_at":{"$ref":"#/$defs/Utc"}}},
    "RepairRequest":{"type":"object","additionalProperties":false,"required":["schema_version","operation_id","task_id","execution_id","context_hash","original_result","validator_errors","output_schema_version","guardrail_policy_version","deadline"],"properties":{"schema_version":{"const":"1.0.0"},"operation_id":{"$ref":"#/$defs/OperationId"},"task_id":{"$ref":"#/$defs/TaskId"},"execution_id":{"$ref":"#/$defs/ExecutionId"},"context_hash":{"$ref":"#/$defs/Hash"},"original_result":{"$ref":"#/$defs/ReasoningResultDTO"},"validator_errors":{"type":"array","minItems":1,"maxItems":100,"items":{"$ref":"#/$defs/DiagnosticDTO"}},"output_schema_version":{"const":"1.0.0"},"guardrail_policy_version":{"type":"string","pattern":"^[a-z0-9_-]+-[0-9]+\\.[0-9]+\\.[0-9]+$"},"deadline":{"$ref":"#/$defs/Deadline"}}},
    "HealthRequest":{"type":"object","additionalProperties":false,"required":["schema_version","operation_id","model_role","deadline"],"properties":{"schema_version":{"const":"1.0.0"},"operation_id":{"$ref":"#/$defs/OperationId"},"model_role":{"enum":["primary","fallback"]},"deadline":{"$ref":"#/$defs/Deadline"}}},
    "GenerateOperation":{"x-contract-test-id":"CT-REASON-GENERATE-01","x-method-policy":{"timeout_by_model_role_ms":{"primary":60000,"fallback":60000},"retry_owner":"core","max_attempts":1,"hidden_adapter_retries":false,"idempotency":{"mode":"operation_context_role_model_identity","key_fields":["operation_id","context_hash","model_role","output_schema_version"]},"concurrency":{"mode":"core_sequenced_single_model_call"},"cancellation":{"deadline_propagated":true},"semantic_invariants":["primary_then_at_most_one_primary_repair_then_fallback_then_validate","invalid_fallback_is_not_published"],"error_codes":["context_invalid","context_too_large","guardrail_rejected","reasoning_schema_invalid","citation_invalid","numeric_inconsistency","reasoning_timeout","reasoning_rate_limited","model_unavailable","fallback_unavailable","deadline_exceeded","unexpected_provider_error"]},"type":"object","additionalProperties":false,"required":["method","request","response"],"properties":{"method":{"const":"generate"},"request":{"$ref":"#/$defs/GenerateRequest"},"response":{"oneOf":[{"$ref":"#/$defs/ReasoningResultDTO"},{"$ref":"#/$defs/GenerateErrorResult"}]}}},
    "RepairOperation":{"x-contract-test-id":"CT-REASON-REPAIR-01","x-method-policy":{"timeout_ms":60000,"retry_owner":"core","max_attempts":1,"hidden_adapter_retries":false,"idempotency":{"mode":"operation_context_original_result_identity","key_fields":["operation_id","context_hash"]},"concurrency":{"mode":"at_most_one_primary_repair"},"cancellation":{"deadline_propagated":true},"semantic_invariants":["repair_only_after_primary_validation_failure"],"error_codes":["guardrail_rejected","reasoning_schema_invalid","citation_invalid","numeric_inconsistency","reasoning_timeout","reasoning_rate_limited","model_unavailable","deadline_exceeded","unexpected_provider_error"]},"type":"object","additionalProperties":false,"required":["method","request","response"],"properties":{"method":{"const":"repair"},"request":{"$ref":"#/$defs/RepairRequest"},"response":{"oneOf":[{"$ref":"#/$defs/ReasoningResultDTO"},{"$ref":"#/$defs/RepairErrorResult"}]}}},
    "HealthOperation":{"x-contract-test-id":"CT-REASON-HEALTH-01","x-method-policy":{"timeout_ms":3000,"retry_owner":"core","max_attempts":1,"hidden_adapter_retries":false,"idempotency":{"mode":"side_effect_free_health_read","key_fields":["operation_id","model_role"]},"concurrency":{"mode":"independent_health_reads"},"error_codes":["reasoning_timeout","model_unavailable","fallback_unavailable","deadline_exceeded","unexpected_provider_error"]},"type":"object","additionalProperties":false,"required":["method","request","response"],"properties":{"method":{"const":"health_check"},"request":{"$ref":"#/$defs/HealthRequest"},"response":{"oneOf":[{"$ref":"#/$defs/Health"},{"$ref":"#/$defs/HealthErrorResult"}]}}}
  }
}
