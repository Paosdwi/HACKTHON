{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://schemas.cryptotrust.local/ports/event-publisher/1.0.0/contract.schema.json",
  "title":"EventPublisher Port contract",
  "x-contract-version":"1.0.0",
  "x-port-policy":{"retry_owner":"application","hidden_adapter_retries":false,"timeouts_ms":{"publish":2000,"publish_batch":3000},"delivery":"at-least-once with logical deduplication by event_id","idempotency":"same event_id and payload is no-op; different payload is integrity conflict","ordering":"no global order; consumers sort an execution by timestamp then event_id"},
  "x-error-codes":["event_schema_invalid","event_redaction_failed","event_too_large","event_id_conflict","publisher_rate_limited","publisher_unavailable","publish_timeout","deadline_exceeded","unexpected_provider_error"],
  "oneOf":[{"$ref":"#/$defs/PublishOperation"},{"$ref":"#/$defs/PublishBatchOperation"}],
  "$defs":{
    "Deadline":{"$ref":"https://schemas.cryptotrust.local/common/1.0.0/common.schema.json#/$defs/DeadlineDTO"},"OperationId":{"$ref":"https://schemas.cryptotrust.local/common/1.0.0/common.schema.json#/$defs/OperationId"},"TaskId":{"$ref":"https://schemas.cryptotrust.local/common/1.0.0/common.schema.json#/$defs/TaskId"},"ExecutionId":{"$ref":"https://schemas.cryptotrust.local/common/1.0.0/common.schema.json#/$defs/ExecutionId"},"Utc":{"$ref":"https://schemas.cryptotrust.local/common/1.0.0/common.schema.json#/$defs/UtcInstant"},
    "PublishErrorResult":{"allOf":[{"$ref":"https://schemas.cryptotrust.local/common/1.0.0/common.schema.json#/$defs/ErrorResult"},{"properties":{"error":{"properties":{"code":{"enum":["event_schema_invalid","event_redaction_failed","event_too_large","event_id_conflict","publisher_rate_limited","publisher_unavailable","publish_timeout","deadline_exceeded","unexpected_provider_error"]}}}}}]},
    "PublishBatchErrorResult":{"allOf":[{"$ref":"https://schemas.cryptotrust.local/common/1.0.0/common.schema.json#/$defs/ErrorResult"},{"properties":{"error":{"properties":{"code":{"enum":["event_schema_invalid","event_redaction_failed","event_too_large","event_id_conflict","publisher_rate_limited","publisher_unavailable","publish_timeout","deadline_exceeded","unexpected_provider_error"]}}}}}]},
    "SafeValue":{"oneOf":[{"type":"string","maxLength":512},{"type":"integer"},{"type":"boolean"},{"type":"null"}]},
    "SafeMap":{"type":"object","maxProperties":64,"additionalProperties":{"$ref":"#/$defs/SafeValue"},"propertyNames":{"not":{"pattern":"authorization|token|secret|password|prompt|raw_content"}}},
    "EventErrorDTO":{"type":"object","additionalProperties":false,"required":["code","category","retryable","safe_message"],"properties":{"code":{"type":"string","pattern":"^[a-z][a-z0-9_]{0,63}$"},"category":{"enum":["validation","timeout","unavailable","integrity","unexpected"]},"retryable":{"type":"boolean"},"safe_message":{"type":"string","minLength":1,"maxLength":512}}},
    "CorrelationDTO":{"type":"object","additionalProperties":false,"required":["operation_id","causation_event_id"],"properties":{"operation_id":{"$ref":"#/$defs/OperationId"},"causation_event_id":{"oneOf":[{"type":"null"},{"type":"string","pattern":"^EVT-"}]}}},
    "ExecutionEventDTO":{"type":"object","additionalProperties":false,"required":["schema_version","event_id","timestamp","task_id","execution_id","step","tool","status","duration_ms","retry_count","sanitized_parameters","result_summary","error","deadline_remaining_ms","correlation"],"properties":{"schema_version":{"const":"1.0.0"},"event_id":{"type":"string","pattern":"^EVT-"},"timestamp":{"$ref":"#/$defs/Utc"},"task_id":{"$ref":"#/$defs/TaskId"},"execution_id":{"$ref":"#/$defs/ExecutionId"},"step":{"type":"string","pattern":"^[a-z][a-z0-9_]{0,63}$"},"tool":{"type":"string","pattern":"^[a-z][a-z0-9_]{0,127}$"},"status":{"enum":["started","completed","failed","skipped","degraded"]},"duration_ms":{"type":"integer","minimum":0,"maximum":900000},"retry_count":{"type":"integer","minimum":0,"maximum":10},"sanitized_parameters":{"$ref":"#/$defs/SafeMap"},"result_summary":{"$ref":"#/$defs/SafeMap"},"error":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/EventErrorDTO"}]},"deadline_remaining_ms":{"type":"integer","minimum":0,"maximum":900000},"correlation":{"$ref":"#/$defs/CorrelationDTO"}}},
    "PublishRequest":{"type":"object","additionalProperties":false,"required":["schema_version","operation_id","event","deadline"],"properties":{"schema_version":{"const":"1.0.0"},"operation_id":{"$ref":"#/$defs/OperationId"},"event":{"$ref":"#/$defs/ExecutionEventDTO"},"deadline":{"$ref":"#/$defs/Deadline"}}},
    "PublishReceiptDTO":{"type":"object","additionalProperties":false,"required":["schema_version","event_id","outcome","published_at"],"properties":{"schema_version":{"const":"1.0.0"},"event_id":{"type":"string","pattern":"^EVT-"},"outcome":{"enum":["published","existing"]},"published_at":{"$ref":"#/$defs/Utc"}}},
    "PublishBatchRequest":{"type":"object","additionalProperties":false,"required":["schema_version","operation_id","events","deadline"],"properties":{"schema_version":{"const":"1.0.0"},"operation_id":{"$ref":"#/$defs/OperationId"},"events":{"type":"array","minItems":1,"maxItems":100,"items":{"$ref":"#/$defs/ExecutionEventDTO"}},"deadline":{"$ref":"#/$defs/Deadline"}}},
    "BatchItemReceiptDTO":{"type":"object","additionalProperties":false,"required":["event_id","outcome","error_code"],"properties":{"event_id":{"type":"string","pattern":"^EVT-"},"outcome":{"enum":["published","existing","failed"]},"error_code":{"oneOf":[{"type":"null"},{"type":"string","pattern":"^[a-z][a-z0-9_]{0,63}$"}]}}},
    "PublishBatchReceiptDTO":{"type":"object","additionalProperties":false,"required":["schema_version","items","published_at"],"properties":{"schema_version":{"const":"1.0.0"},"items":{"type":"array","minItems":1,"maxItems":100,"items":{"$ref":"#/$defs/BatchItemReceiptDTO"}},"published_at":{"$ref":"#/$defs/Utc"}}},
    "PublishOperation":{"x-contract-test-id":"CT-EVENT-PUBLISH-01","x-method-policy":{"timeout_ms":2000,"retry_owner":"application","max_attempts":1,"hidden_adapter_retries":false,"idempotency":{"mode":"event_id_payload_deduplication","key_fields":["event.event_id"]},"concurrency":{"mode":"at_least_once_logical_deduplication"},"semantic_invariants":["application_owns_retries","retries_reuse_event_id","same_event_id_same_payload_is_no_op","same_event_id_different_payload_is_integrity_conflict"],"error_codes":["event_schema_invalid","event_redaction_failed","event_too_large","event_id_conflict","publisher_rate_limited","publisher_unavailable","publish_timeout","deadline_exceeded","unexpected_provider_error"]},"type":"object","additionalProperties":false,"required":["method","request","response"],"properties":{"method":{"const":"publish"},"request":{"$ref":"#/$defs/PublishRequest"},"response":{"oneOf":[{"$ref":"#/$defs/PublishReceiptDTO"},{"$ref":"#/$defs/PublishErrorResult"}]}}},
    "PublishBatchOperation":{"x-contract-test-id":"CT-EVENT-BATCH-01","x-method-policy":{"timeout_ms":3000,"retry_owner":"application","max_attempts":1,"hidden_adapter_retries":false,"idempotency":{"mode":"per_event_id_payload_deduplication","key_fields":["events[].event_id"]},"concurrency":{"mode":"at_least_once_batch_with_item_deduplication"},"semantic_invariants":["application_owns_retries","retries_reuse_each_event_id","deduplication_is_per_event_id_and_payload"],"error_codes":["event_schema_invalid","event_redaction_failed","event_too_large","event_id_conflict","publisher_rate_limited","publisher_unavailable","publish_timeout","deadline_exceeded","unexpected_provider_error"]},"type":"object","additionalProperties":false,"required":["method","request","response"],"properties":{"method":{"const":"publish_batch"},"request":{"$ref":"#/$defs/PublishBatchRequest"},"response":{"oneOf":[{"$ref":"#/$defs/PublishBatchReceiptDTO"},{"$ref":"#/$defs/PublishBatchErrorResult"}]}}}
  }
}
