{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://schemas.cryptotrust.local/ports/market-regime-provider/1.0.0/contract.schema.json",
  "title":"MarketRegimeProvider Port contract",
  "x-contract-version":"1.0.0",
  "x-port-policy":{"retry_owner":"core","provider_retries":0,"hidden_adapter_retries":false,"infer_timeout_ms":25000,"fallback_reserve_ms":5000,"health_timeout_ms":3000,"fallback_owner":"core","fallback_contract":"Core creates a versioned deterministic fallback AnalysisResult; adapter never synthesizes probabilities","idempotency":"operation_id plus feature hash and model version identify one inference","concurrency":"stateless inference; no persistence side effects"},
  "x-forbidden-output-fields":["fallback","fallback_probabilities","synthetic_probabilities"],
  "x-error-codes":["invalid_feature_schema","feature_alignment_error","model_version_mismatch","invalid_probability_distribution","market_regime_timeout","endpoint_unavailable","provider_rate_limited","invalid_provider_output","deadline_exceeded","unexpected_provider_error"],
  "oneOf":[{"$ref":"#/$defs/InferOperation"},{"$ref":"#/$defs/HealthOperation"}],
  "$defs":{
    "Deadline":{"$ref":"https://schemas.cryptotrust.local/common/1.0.0/common.schema.json#/$defs/DeadlineDTO"},"OperationId":{"$ref":"https://schemas.cryptotrust.local/common/1.0.0/common.schema.json#/$defs/OperationId"},"TaskId":{"$ref":"https://schemas.cryptotrust.local/common/1.0.0/common.schema.json#/$defs/TaskId"},"ExecutionId":{"$ref":"https://schemas.cryptotrust.local/common/1.0.0/common.schema.json#/$defs/ExecutionId"},"Utc":{"$ref":"https://schemas.cryptotrust.local/common/1.0.0/common.schema.json#/$defs/UtcInstant"},"Date":{"$ref":"https://schemas.cryptotrust.local/common/1.0.0/common.schema.json#/$defs/UtcDate"},"Hash":{"$ref":"https://schemas.cryptotrust.local/common/1.0.0/common.schema.json#/$defs/Sha256"},"Decimal":{"$ref":"https://schemas.cryptotrust.local/common/1.0.0/common.schema.json#/$defs/CanonicalDecimal"},"Probability":{"$ref":"https://schemas.cryptotrust.local/common/1.0.0/common.schema.json#/$defs/Probability"},"Health":{"$ref":"https://schemas.cryptotrust.local/common/1.0.0/common.schema.json#/$defs/ProviderHealthDTO"},
    "InferErrorResult":{"allOf":[{"$ref":"https://schemas.cryptotrust.local/common/1.0.0/common.schema.json#/$defs/ErrorResult"},{"properties":{"error":{"properties":{"code":{"enum":["invalid_feature_schema","feature_alignment_error","model_version_mismatch","invalid_probability_distribution","market_regime_timeout","endpoint_unavailable","provider_rate_limited","invalid_provider_output","deadline_exceeded","unexpected_provider_error"]}}}}}]},
    "HealthErrorResult":{"allOf":[{"$ref":"https://schemas.cryptotrust.local/common/1.0.0/common.schema.json#/$defs/ErrorResult"},{"properties":{"error":{"properties":{"code":{"enum":["market_regime_timeout","endpoint_unavailable","deadline_exceeded","unexpected_provider_error"]}}}}}]},
    "FeatureWindowDTO":{"type":"object","additionalProperties":false,"required":["start","end"],"properties":{"start":{"$ref":"#/$defs/Date"},"end":{"$ref":"#/$defs/Date"}}},
    "FeatureDTO":{"type":"object","additionalProperties":false,"required":["name","value","calculation_version","source_refs"],"properties":{"name":{"type":"string","pattern":"^[a-z][a-z0-9_]{0,63}$"},"value":{"$ref":"#/$defs/Decimal"},"calculation_version":{"type":"string","pattern":"^[a-z0-9_-]+-[0-9]+\\.[0-9]+\\.[0-9]+$"},"source_refs":{"type":"array","minItems":1,"maxItems":100,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":256}}}},
    "ExpectedModelDTO":{"type":"object","additionalProperties":false,"required":["name","contract_version"],"properties":{"name":{"type":"string","minLength":1,"maxLength":128},"contract_version":{"const":"1.0.0"}}},
    "InferRequest":{"type":"object","additionalProperties":false,"required":["schema_version","operation_id","task_id","execution_id","asset","as_of","feature_window","features","input_feature_hash","expected_model","deadline"],"properties":{"schema_version":{"const":"1.0.0"},"operation_id":{"$ref":"#/$defs/OperationId"},"task_id":{"$ref":"#/$defs/TaskId"},"execution_id":{"$ref":"#/$defs/ExecutionId"},"asset":{"$ref":"https://schemas.cryptotrust.local/common/1.0.0/common.schema.json#/$defs/Asset"},"as_of":{"$ref":"#/$defs/Utc"},"feature_window":{"$ref":"#/$defs/FeatureWindowDTO"},"features":{"type":"array","minItems":1,"maxItems":256,"items":{"$ref":"#/$defs/FeatureDTO"}},"input_feature_hash":{"$ref":"#/$defs/Hash"},"expected_model":{"$ref":"#/$defs/ExpectedModelDTO"},"deadline":{"$ref":"#/$defs/Deadline"}}},
    "ModelDTO":{"type":"object","additionalProperties":false,"required":["name","version","invocation_id"],"properties":{"name":{"type":"string","minLength":1,"maxLength":128},"version":{"type":"string","minLength":1,"maxLength":128},"invocation_id":{"type":"string","minLength":1,"maxLength":128}}},
    "ProbabilityDistributionDTO":{"type":"object","additionalProperties":false,"required":["bullish","bearish","sideways"],"properties":{"bullish":{"$ref":"#/$defs/Probability"},"bearish":{"$ref":"#/$defs/Probability"},"sideways":{"$ref":"#/$defs/Probability"}},"x-sum-target":"1","x-sum-tolerance":"0.000001"},
    "MarketRegimeResultDTO":{"type":"object","additionalProperties":false,"required":["schema_version","operation_id","asset","as_of","model","probabilities","anomaly_score","feature_window","input_feature_hash","computed_at","quality","limitations"],"properties":{"schema_version":{"const":"1.0.0"},"operation_id":{"$ref":"#/$defs/OperationId"},"asset":{"$ref":"https://schemas.cryptotrust.local/common/1.0.0/common.schema.json#/$defs/Asset"},"as_of":{"$ref":"#/$defs/Utc"},"model":{"$ref":"#/$defs/ModelDTO"},"probabilities":{"$ref":"#/$defs/ProbabilityDistributionDTO"},"anomaly_score":{"$ref":"#/$defs/Probability"},"feature_window":{"$ref":"#/$defs/FeatureWindowDTO"},"input_feature_hash":{"$ref":"#/$defs/Hash"},"computed_at":{"$ref":"#/$defs/Utc"},"quality":{"enum":["valid","degraded_input"]},"limitations":{"type":"array","maxItems":50,"items":{"type":"string","minLength":1,"maxLength":512}}}},
    "HealthRequest":{"type":"object","additionalProperties":false,"required":["schema_version","operation_id","deadline"],"properties":{"schema_version":{"const":"1.0.0"},"operation_id":{"$ref":"#/$defs/OperationId"},"deadline":{"$ref":"#/$defs/Deadline"}}},
    "InferOperation":{"x-contract-test-id":"CT-MARKET-INFER-01","x-method-policy":{"timeout_ms":25000,"retry_owner":"core","max_attempts":1,"hidden_adapter_retries":false,"idempotency":{"mode":"operation_feature_model_identity","key_fields":["operation_id","input_feature_hash","expected_model.name","expected_model.contract_version"]},"concurrency":{"mode":"stateless_no_persistence_side_effects"},"semantic_invariants":["adapter_returns_schema_valid_result_or_typed_error","core_owns_deterministic_fallback","adapter_never_synthesizes_probabilities"],"error_codes":["invalid_feature_schema","feature_alignment_error","model_version_mismatch","invalid_probability_distribution","market_regime_timeout","endpoint_unavailable","provider_rate_limited","invalid_provider_output","deadline_exceeded","unexpected_provider_error"]},"type":"object","additionalProperties":false,"required":["method","request","response"],"properties":{"method":{"const":"infer"},"request":{"$ref":"#/$defs/InferRequest"},"response":{"oneOf":[{"$ref":"#/$defs/MarketRegimeResultDTO"},{"$ref":"#/$defs/InferErrorResult"}]}}},
    "HealthOperation":{"x-contract-test-id":"CT-MARKET-HEALTH-01","x-method-policy":{"timeout_ms":3000,"retry_owner":"core","max_attempts":1,"hidden_adapter_retries":false,"idempotency":{"mode":"side_effect_free_health_read","key_fields":["operation_id"]},"concurrency":{"mode":"independent_health_reads"},"semantic_invariants":["core_owns_fallback","adapter_never_synthesizes_probabilities"],"error_codes":["market_regime_timeout","endpoint_unavailable","deadline_exceeded","unexpected_provider_error"]},"type":"object","additionalProperties":false,"required":["method","request","response"],"properties":{"method":{"const":"health_check"},"request":{"$ref":"#/$defs/HealthRequest"},"response":{"oneOf":[{"$ref":"#/$defs/Health"},{"$ref":"#/$defs/HealthErrorResult"}]}}}
  }
}
