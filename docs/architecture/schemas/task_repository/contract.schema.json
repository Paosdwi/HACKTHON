    "CreateOrGetOperation": { "x-contract-test-id": "CT-TASK-CREATE-OR-GET-01", "x-method-policy":{"timeout_ms":2000,"retry_owner":"application","max_attempts":1,"hidden_adapter_retries":false,"idempotency":{"mode":"operation_and_fingerprint_window","key_fields":["operation_id","trusted_user_scope","request_fingerprint"]},"concurrency":{"mode":"conditional_unique_fingerprint_window"},"error_codes":["task_version_conflict","fingerprint_index_conflict","repository_unavailable","deadline_exceeded","unexpected_provider_error"]}, "type": "object", "additionalProperties": false, "required": ["method", "request", "response"], "properties": { "method": { "const": "create_or_get" }, "request": { "$ref": "#/$defs/CreateOrGetRequest" }, "response": { "oneOf": [{ "$ref": "#/$defs/CreateOrGetResponse" }, { "$ref": "#/$defs/CreateOrGetErrorResult" }] } } },
    "GetOperation": { "x-contract-test-id": "CT-TASK-GET-01", "x-method-policy":{"timeout_ms":2000,"retry_owner":"application","max_attempts":1,"hidden_adapter_retries":false,"idempotency":{"mode":"side_effect_free_read","key_fields":["trusted_user_scope","task_id"]},"concurrency":{"mode":"consistent_read"},"error_codes":["task_not_found","repository_unavailable","deadline_exceeded","unexpected_provider_error"]}, "type": "object", "additionalProperties": false, "required": ["method", "request", "response"], "properties": { "method": { "const": "get" }, "request": { "$ref": "#/$defs/TaskQueryRequest" }, "response": { "oneOf": [{ "$ref": "#/$defs/TaskRecordDTO" }, { "$ref": "#/$defs/GetErrorResult" }] } } },
    "ConsumePreflightSlotOperation": { "x-contract-test-id": "CT-TASK-CONSUME-PREFLIGHT-01", "x-method-policy":{"timeout_ms":2000,"retry_owner":"application","max_attempts":1,"hidden_adapter_retries":false,"idempotency":{"mode":"operation_replay","key_fields":["operation_id"]},"concurrency":{"mode":"atomic_task_scoped_rate_counter"},"error_codes":["task_not_found","preflight_rate_limited","repository_unavailable","deadline_exceeded","unexpected_provider_error"]}, "type": "object", "additionalProperties": false, "required": ["method", "request", "response"], "properties": { "method": { "const": "consume_preflight_slot" }, "request": { "$ref": "#/$defs/ConsumePreflightSlotRequest" }, "response": { "oneOf": [{ "$ref": "#/$defs/RateLimitDecisionDTO" }, { "$ref": "#/$defs/ConsumePreflightSlotErrorResult" }] } } },
    "AppendPreflightResultOperation": { "x-contract-test-id": "CT-TASK-APPEND-PREFLIGHT-01", "x-method-policy":{"timeout_ms":2000,"retry_owner":"application","max_attempts":1,"hidden_adapter_retries":false,"idempotency":{"mode":"operation_and_preflight_identity","key_fields":["operation_id","record.preflight_id"]},"concurrency":{"mode":"conditional_task_version_write"},"semantic_invariants":["expires_at_equals_checked_at_plus_60_seconds"],"error_codes":["task_not_found","task_version_conflict","repository_unavailable","deadline_exceeded","unexpected_provider_error"]}, "type": "object", "additionalProperties": false, "required": ["method", "request", "response"], "properties": { "method": { "const": "append_preflight_result" }, "request": { "$ref": "#/$defs/AppendPreflightResultRequest" }, "response": { "oneOf": [{ "$ref": "#/$defs/PreflightRecordDTO" }, { "$ref": "#/$defs/AppendPreflightResultErrorResult" }] } } },
    "GetLatestPreflightOperation": { "x-contract-test-id": "CT-TASK-GET-PREFLIGHT-01", "x-method-policy":{"timeout_ms":2000,"retry_owner":"application","max_attempts":1,"hidden_adapter_retries":false,"idempotency":{"mode":"side_effect_free_read","key_fields":["task_id","task_version","input_lock_hash"]},"concurrency":{"mode":"latest_matching_consistent_read"},"semantic_invariants":["task_version_and_input_lock_hash_match","single_use_state_visible"],"error_codes":["task_not_found","preflight_not_passed","preflight_expired","preflight_consumed","repository_unavailable","deadline_exceeded","unexpected_provider_error"]}, "type": "object", "additionalProperties": false, "required": ["method", "request", "response"], "properties": { "method": { "const": "get_latest_preflight" }, "request": { "$ref": "#/$defs/GetLatestPreflightRequest" }, "response": { "oneOf": [{ "$ref": "#/$defs/PreflightRecordDTO" }, { "$ref": "#/$defs/GetLatestPreflightErrorResult" }] } } }
  }
}
